# WhatsApp Cloud API access token (Meta for Developers → your app → WhatsApp → API Setup)
WHATSAPP_ACCESS_TOKEN=

# Must match the "Verify token" you enter in Meta's webhook configuration UI
VERIFY_TOKEN=

# Devara Hotels MCP endpoint (defaults to the production one below if unset)
MCP_URL=https://devara-hotel-site.vercel.app/api/mcp

# KV_* vars are injected automatically once a Vercel KV store is attached to
# this project (Vercel dashboard → Storage → Create Database → KV → Connect
# to Project). No need to set these manually for a deployed project — only
# needed locally if running `vercel dev` without `vercel env pull`.
# KV_URL=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# KV_REST_API_READ_ONLY_TOKEN=

# Stripe TEST-mode secret key for the demo payment step (Stripe dashboard →
# Developers → API keys, with "Test mode" on). Must start with sk_test_ —
# the app refuses live keys. Enable for Production AND Preview in Vercel.
STRIPE_SECRET_KEY=

# Public URL Stripe sends the guest back to after paying. Falls back to the
# request's own host if unset.
PUBLIC_BASE_URL=https://whatsapp-booking-agent.vercel.app

# Calendar date picker (WhatsApp Flow). Create the Flow with
# `node scripts/create-flow.js`, then set its id here. Leave unset to keep
# typed dates only.
WHATSAPP_DATES_FLOW_ID=
# Set to "draft" while the Flow is unpublished (draft Flows must be sent in draft mode).
WHATSAPP_FLOW_MODE=
# Time zone used for "today" so the earliest selectable date is right in the evening.
HOTEL_TIMEZONE=America/New_York
